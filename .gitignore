__pycache__/
*.pyc
.venv/
venv/
env/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# data
# Generated output is never committed:
data/processed/
# Extracted shapefile parts aren't committed either (only the zip is) -
# these get regenerated by data/ingest.py's auto-extract step:
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg

# The three small, public source-data files in data/raw/ ARE committed on
# purpose (~700KB total): CI and Docker both need real input data to run
# data/ingest.py end-to-end, and there's nothing sensitive in open
# CSO/Pobal/EPA government data. If you add other files to data/raw/
# locally (e.g. a personal copy of something larger), they'll be ignored
# by the two catch-all rules below unless you also add them here.
data/raw/*
!data/raw/SAPS_2022_county_270923.csv
!data/raw/hp-deprivation-index-scores-2022.csv
!data/raw/LicensedFacilities_16062026.zip

# The dashboard's map boundaries are a generated file too (data/build_boundaries.py
# produces it from a public CSO boundary source), but at ~470KB it's committed
# directly rather than regenerated on every run/build, since the raw source it's
# built from is a much larger one-off download not otherwise needed by the app.
!data/raw/local_authority_boundaries.geojson

# docker
*.log
